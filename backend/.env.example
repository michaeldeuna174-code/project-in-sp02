# CyberSafe Backend Environment Configuration
# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env to GitHub.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (the backend also allows localhost/127.0.0.1
# origins in development). Set this to your deployed frontend URL in production.
FRONTEND_URL=https://cybersafeawareness.netlify.app

# Supabase PostgreSQL Configuration
# Supabase Dashboard -> Project Settings -> API
# The service role key is backend-only. Never expose it in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct PostgreSQL connection string
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# Session / JWT secret (use a long random value; do not reuse the example)
SESSION_SECRET=

# Optional local-development administrator fallback.
# Leave blank in production. Prefer `npm run create-admin -- <username>`.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Optional bcrypt cost (defaults to 12 in createAdmin.js)
BCRYPT_ROUNDS=12
